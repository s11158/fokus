# Скопируйте этот файл в .env и заполните. .env НЕ коммитить.

# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic для AI-разбора (без него бот кладёт сырой текст как заголовок)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Порт локального моста (приложение опрашивает этот адрес)
BRIDGE_PORT=8787

# STT для голосовых (OpenAI-совместимый Whisper). Без этого голос не распознаётся.
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
